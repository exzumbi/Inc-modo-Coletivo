{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meu-backstage-incomodo",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
