  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "4.156.0"
  }
}
